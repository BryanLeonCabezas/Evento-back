{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "sourceMap": true,
    "declaration": true,

    "strict": true,
    "skipLibCheck": true,

    "isolatedModules": false,
    "verbatimModuleSyntax": false
  },
  /* ===============================
     LIMITA LO QUE ANALIZA TS
     =============================== */
  "include": ["src/**/*.ts"],

  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".git",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
