{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "sourceMap": true,
    "declaration": true,

    "strict": true,
    "skipLibCheck": true,

    // ⚠️ IMPORTANTE: estos dos deben ir en false
    "isolatedModules": false,
    "verbatimModuleSyntax": false
  }
}
